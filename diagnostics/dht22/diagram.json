{
  "version": 1,
  "author": "CNA Sentinel - DHT22 diagnostic",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 40, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": 40, "left": 300, "attrs": { "temperature": "24", "humidity": "40" } },
    { "type": "wokwi-resistor", "id": "pullup", "top": 170, "left": 260, "rotate": 90, "attrs": { "value": "4700" } }
  ],
  "connections": [
    ["esp:TX0", "$serialMonitor:RX", "", []],
    ["esp:RX0", "$serialMonitor:TX", "", []],
    ["esp:3V3", "dht:VCC", "red", []],
    ["esp:GND.1", "dht:GND", "black", []],
    ["esp:D4", "dht:SDA", "green", []],
    ["esp:3V3", "pullup:1", "red", []],
    ["pullup:2", "dht:SDA", "green", []]
  ],
  "serialMonitor": {
    "display": "always",
    "newline": "lf"
  }
}
