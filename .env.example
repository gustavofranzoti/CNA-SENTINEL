# Copie para .env na raiz e preencha os parâmetros do listener confirmado.
# O firmware usa firmware/include/mqtt_config.h.
WIFI_SSID=
WIFI_PASSWORD=
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8884
MQTT_TRANSPORT=wss
# Para ws ou wss, informe o caminho começando com /. Para mqtts, deixe vazio.
MQTT_WS_PATH=/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BRIDGE_CLIENT_ID=cna-sentinel-bridge
MQTT_DRONE_CLIENT_ID=cna-sentinel-drone
# CA opcional em PEM para WSS/MQTTS. Vazio usa as CAs do sistema.
MQTT_CA_CERT=
# Certificado de cliente e chave em PEM, opcionais e usados pelo drone em TLS.
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
UBIDOTS_TOKEN=
UBIDOTS_DEVICE=
