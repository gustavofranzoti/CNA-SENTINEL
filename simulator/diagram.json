    { "type": "wokwi-slide-switch", "id": "access", "top": 80, "left": -260, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "tamper", "top": 200, "left": -260, "attrs": { "color": "red", "label": "TAMPER", "bounce": "0" } },
    { "type": "wokwi-dht22", "id": "dht", "top": -150, "left": -80, "attrs": { "temperature": "24", "humidity": "40" } },
    { "type": "wokwi-resistor", "id": "rDht", "top": 15, "left": -70, "rotate": 90, "attrs": { "value": "4700" } },
